; ============================================================
; TGBot 配置面板 — Quantumult X 配置片段
;
; 【方案 A】本机服务版（推荐，无需域名 / 证书 / 劫持）
;   QX 在本机起服务，浏览器直接访问：
;     http://127.0.0.1:9999/tgbot/v1/
;   面板与 API 同源，不存在跨域问题。
;
; 【方案 B】劫持式（需要你有自己的域名）
;   见文件末尾，当前配置为 xiaomaotgbot.com。
; ============================================================

; ---------- 方案 A：推荐 ----------
[http_backend]
https://raw.githubusercontent.com/xiaomaoJT/QxScript/refs/heads/main/rewrite/script/qx-tgbot/tgbot-backend.js, tag=tgbot, path=^/tgbot/v1/, enabled=true


; ---------- 方案 B：劫持式 ----------
; 说明：目标域名必须写进下方 [mitm] hostname 并信任证书；
;      api.telegram.org 那条是本地 CORS 代理，因官方无 CORS 头。

[rewrite_local]
^https?://xiaomaotgbot\.com/ url script-response-body https://raw.githubusercontent.com/xiaomaoJT/QxScript/refs/heads/main/rewrite/script/qx-tgbot/tgbot-panel-inject.js
^https://api\.telegram\.org/bot url script-echo-response https://raw.githubusercontent.com/xiaomaoJT/QxScript/refs/heads/main/rewrite/script/qx-tgbot/tgbot-cors.js

[mitm]
hostname = xiaomaotgbot.com, *.xiaomaotgbot.com, api.telegram.org