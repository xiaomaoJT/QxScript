    {
      "id": "reverseVip",
      "name": "会员解锁 · VipPatch",
      "keys": [
        "vipHost",
        "vipPath",
        "vipVipFields",
        "vipTimeFields",
        "vipTimeValue",
        "vipLevelFields",
        "vipLevelValue",
        "vipDeleteFields",
        "vipWholeJson",
        "vipNotify",
        "vipDiscovery"
      ],
      "descs_html": [
        "<h4 align=\"center\">激活方式：QX 重写 → 规则资源 → 引用 <a href=\"https://raw.githubusercontent.com/xiaomaoJT/QxScript/main/rewrite/boxJS/XiaoMaoReverseTools.js\">XiaoMaoReverseTools.js</a></h4><br/><h5 align=\"left\">免改代码的一条规则：填域名+字段即可解锁。也可在内联 RULES 写多条高级规则。</h5>"
      ],
      "settings": [
