{
  "id": "XiaoMao.reverse.tools",
  "name": "XiaoMao 逆向工具箱",
  "author": "@XiaoMao",
  "icon": "https://avatars.githubusercontent.com/u/49260609",
  "repo": "https://github.com/xiaomaoJT/QxScript",
  "apps": [
    {
      "id": "reverseSignLab",
      "name": "签名还原 · SignLab",
      "keys": [
        "signlabHosts",
        "signlabPathFilter",
        "signlabNotify",
        "signlabDiscovery",
        "signlabSignKeys",
        "signlabTsKeys",
        "signlabSaltDict",
        "signlabMaxCandidates",
        "signlabUseBoxJs",
        "signlabAlgos",
        "signlabOrders",
        "signlabJoins",
        "signlabSaltPos",
        "signlabOutCase"
      ],
      "descs_html": [
        "<h4 align=\"center\">激活方式：QX 重写 → 规则资源 → 引用 <a href=\"https://raw.githubusercontent.com/xiaomaoJT/QxScript/main/rewrite/boxJS/XiaoMaoReverseTools.js\">XiaoMaoReverseTools.js</a></h4><br/><h5 align=\"left\">本卡片仅用于配置参数，所有改动即时生效（下次请求即按新参数穷举）。</h5>"
      ],
      "settings": [
        {
          "id": "signlabHosts",
          "name": "目标域名",
          "val": null,
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "要还原签名的域名，多个用逗号分隔。如 api.xx.com,*.xx.com。留空=未配置（脚本静默放行，开启发现模式可抓 host）"
        },
        {
          "id": "signlabPathFilter",
          "name": "路径过滤",
          "val": null,
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "仅对该路径正则生效，如 /api/ 或 /user/info。留空=全部路径。支持 /正则/ 写法"
        },
        {
          "id": "signlabNotify",
          "name": "结论弹通知",
          "val": "1",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "还原出算法/未命中时是否弹通知：1 开 / 0 关"
        },
        {
          "id": "signlabDiscovery",
          "name": "发现模式",
          "val": "0",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "未配置域名时，是否把捕获到的 host/path 打到 QX 日志（不弹窗）：1 开 / 0 关"
        },
        {
          "id": "signlabSignKeys",
          "name": "签名字段名",
          "val": "sign,sig,signature,token,mac,hash,check,verify,sk",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "签名字段名候选（小写比较），逗号分隔。识别不到就加接口里的实际参数名"
        },
        {
          "id": "signlabTsKeys",
          "name": "时间戳字段",
          "val": "timestamp,ts,time,nonce,t",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "时间戳字段候选，逗号分隔（部分签名会把它拼进去）"
        },
        {
          "id": "signlabSaltDict",
          "name": "盐值字典",
          "val": ",salt,secret,key,appkey,app_secret,123456,android,ios,mobile,client",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "desc": "参与签名的盐值/密钥候选，逗号或换行分隔。把 App 里硬编码的 key 加进来能大幅提升命中率"
        },
        {
          "id": "signlabMaxCandidates",
          "name": "最大组合数",
          "val": "60",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "性能上限保护：最多尝试多少组组合，默认 60。太小可能漏、太大更慢"
        },
        {
          "id": "signlabUseBoxJs",
          "name": "缓存结论",
          "val": "1",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "是否把还原成功的算法缓存到 BoxJS：1 开 / 0 关（关掉每次都重算）"
        },
        {
          "id": "signlabAlgos",
          "name": "尝试算法",
          "val": "md5,sha1,sha256,hmac-md5,hmac-sha1,hmac-sha256",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "穷举时尝试的算法，逗号分隔。明确算法后可只留一个（如 md5）大幅提速"
        },
        {
          "id": "signlabOrders",
          "name": "参数排序",
          "val": "dict,raw",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "参与签名的参数排序：dict(字典序)/raw(原始序)/reverse(逆序)，逗号分隔"
        },
        {
          "id": "signlabJoins",
          "name": "拼接方式",
          "val": "k=v&",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "键值拼接方式：k=v&(k=v&k=v)/v&v/k&v/kv拼接/无分隔，逗号分隔"
        },
        {
          "id": "signlabSaltPos",
          "name": "盐位置",
          "val": "both",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "盐值位置：pre(前置)/post(后置)/both(都试)，默认 both"
        },
        {
          "id": "signlabOutCase",
          "name": "输出大小写",
          "val": "lower",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "显示用大小写：lower/upper（不影响比对，比对恒忽略大小写）"
        }
      ],
      "author": "@XiaoMao",
      "repo": "https://github.com/xiaomaoJT/QxScript",
      "icons": [
        "https://avatars.githubusercontent.com/u/49260609",
        "https://avatars.githubusercontent.com/u/49260609"
      ],
      "script": "https://raw.githubusercontent.com/xiaomaoJT/QxScript/main/rewrite/script/js/sign_lab.js"
    },
    {
      "id": "reverseInspector",
      "name": "响应分析 · Inspector",
      "keys": [
        "inspHosts",
        "inspPathFilter",
        "inspSaveBody",
        "inspMaxDepth",
        "inspNotify",
        "inspDiscovery",
        "inspKeywords",
        "inspValueHints",
        "inspOnlyVip",
        "inspMaxFields",
        "inspShowPath",
        "inspExport"
      ],
      "descs_html": [
        "<h4 align=\"center\">激活方式：QX 重写 → 规则资源 → 引用 <a href=\"https://raw.githubusercontent.com/xiaomaoJT/QxScript/main/rewrite/boxJS/XiaoMaoReverseTools.js\">XiaoMaoReverseTools.js</a></h4><br/><h5 align=\"left\">扫描响应体，标出所有会员/权益/时间字段及完整 JSON 路径。</h5>"
      ],
      "settings": [
        {
          "id": "inspHosts",
          "name": "目标域名",
          "val": null,
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "要分析的域名，多个逗号分隔。留空=未配置（静默放行）"
        },
        {
          "id": "inspPathFilter",
          "name": "路径过滤",
          "val": null,
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "仅分析该路径正则，如 /user/info。留空=全部路径"
        },
        {
          "id": "inspSaveBody",
          "name": "保存响应体",
          "val": "0",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "是否把原始响应存到 $prefs（key: respInspectorBody）反复比对：1 开 / 0 关"
        },
        {
          "id": "inspMaxDepth",
          "name": "递归深度",
          "val": "8",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "JSON 递归扫描的最大深度，默认 8"
        },
        {
          "id": "inspNotify",
          "name": "弹通知",
          "val": "1",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "命中字段时是否弹通知：1 开 / 0 关"
        },
        {
          "id": "inspDiscovery",
          "name": "发现模式",
          "val": "0",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "未配置域名时把捕获到的 host/path 打到日志：1 开 / 0 关"
        },
        {
          "id": "inspKeywords",
          "name": "关键字",
          "val": "vip,member,expire,expiry,unlock,pro,privilege,pay,paid,subscribe,subscription,deadline,endtime,end_time,isvip,ismember,ispro,is_pay,ispay,vipend,viptype,membertype,usertype,level,auth,permission,trial,forever",
          "type": "textarea",
          "autoGrow": true,
          "rows": 3,
          "desc": "字段名命中即标注的关键字（大小写不敏感），逗号分隔"
        },
        {
          "id": "inspValueHints",
          "name": "值特征",
          "val": "vip,会员,svip,premium,已购,永久,forever,pro",
          "type": "textarea",
          "autoGrow": true,
          "rows": 2,
          "desc": "这些值本身很可疑（布尔 true/会员文案等），逗号分隔"
        },
        {
          "id": "inspOnlyVip",
          "name": "只看会员类",
          "val": "0",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "1=只展示会员/权益/过期相关字段，过滤掉普通关键字命中；0=全部"
        },
        {
          "id": "inspMaxFields",
          "name": "最多展示",
          "val": "40",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "最多展示多少个命中字段，默认 40（避免刷屏）"
        },
        {
          "id": "inspShowPath",
          "name": "显示路径",
          "val": "1",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "1=显示完整 JSON 路径（如 data.vip.is_vip）；0=只显示字段名"
        },
        {
          "id": "inspExport",
          "name": "输出格式",
          "val": "text",
          "type": "textarea",
          "autoGrow": true,
          "rows": 1,
          "desc": "日志输出格式：text(可读文本)/json(便于复制存档)"
        }
      ],
      "author": "@XiaoMao",
      "repo": "https://github.com/xiaomaoJT/QxScript",
      "icons": [
        "https://avatars.githubusercontent.com/u/49260609",
